# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional, comma-separated hostnames without https:// for development tunnels
NEXT_DEV_ALLOWED_HOSTS=

# Server-only values
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:operacoes@example.pt
RESEND_API_KEY=
RESEND_FROM="Encomendas <encomendas@example.pt>"
NOTIFICATION_WORKER_SECRET=replace-with-a-long-random-value
MAIL_TRANSPORT=log
